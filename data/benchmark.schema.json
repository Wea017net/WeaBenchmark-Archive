{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark.schema.json",
  "title": "Wea's Benchmark Archive record",
  "description": "One PC game benchmark session. Fields not defined here may be added in future versions.",
  "type": "object",
  "required": ["id", "game", "testedAt", "system", "results"],
  "properties": {
    "id": { "type": "string", "description": "Filename without the .json extension." },
    "game": { "$ref": "#/$defs/localizedText" },
    "testedAt": { "type": "string", "format": "date" },
    "summary": { "$ref": "#/$defs/localizedText" },
    "version": { "$ref": "#/$defs/localizedText" },
    "season": { "$ref": "#/$defs/localizedText" },
    "system": {
      "type": "object",
      "required": ["cpu", "gpu"],
      "properties": {
        "pcModel": { "type": "string", "description": "Optional desktop or laptop model name." },
        "cpu": { "type": "string" },
        "cpuShortName": { "type": "string" },
        "gpu": { "type": "string" },
        "graphicsCardName": { "type": "string", "description": "Specific graphics card product name for the result page." },
        "gpuShortName": { "type": "string" },
        "gpuDriver": { "type": "string" },
        "motherboard": { "type": "string" },
        "memory": {
          "oneOf": [
            { "type": "string" },
            { "type": "object", "properties": { "frequency": { "type": "string" }, "capacity": { "type": "string" } } }
          ]
        },
        "os": { "type": "string" }
      },
      "additionalProperties": true
    },
    "method": { "$ref": "#/$defs/localizedText" },
    "videoUrl": { "type": "string", "format": "uri" },
    "display": {
      "type": "object",
      "description": "Optional website presentation settings. Legacy show* fields are accepted but ignored.",
      "properties": {
        "groupResults": { "type": "boolean", "default": false, "description": "Group result rows when true." },
        "groupBy": {
          "description": "One or more result dimensions used for grouping.",
          "oneOf": [
            { "$ref": "#/$defs/resultGroupField" },
            { "type": "array", "items": { "$ref": "#/$defs/resultGroupField" }, "minItems": 1, "uniqueItems": true }
          ]
        },
        "showUpscaling": { "deprecated": true },
        "showFrameGeneration": { "deprecated": true },
        "showGraphicsApi": { "deprecated": true },
        "graphicsApiLabel": { "deprecated": true }
      },
      "allOf": [
        {
          "if": { "properties": { "groupResults": { "const": true } }, "required": ["groupResults"] },
          "then": { "required": ["groupBy"] }
        }
      ],
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resolutionX", "resolutionY", "preset", "averageFps", "onePercentLowFps"],
        "properties": {
          "resolutionX": { "type": "number" },
          "resolutionY": { "type": "number" },
          "preset": { "$ref": "#/$defs/localizedText" },
          "gameMode": { "$ref": "#/$defs/localizedText", "description": "Optional localized in-game mode shown before the resolution tag." },
          "gameModeKey": { "$ref": "#/$defs/localizedText", "description": "Optional per-result override for the game-mode tag key. Defaults to MODE." },
          "upscalingType": { "type": "string" },
          "upscalingQuality": { "type": "string" },
          "frameGenerationType": { "type": "string", "description": "Frame-generation technology, for example DLSS FG." },
          "frameGenerationMultiplier": { "type": "string", "description": "Frame-generation multiplier, for example 2x." },
          "graphicsApi": { "type": "string" },
          "averageFps": { "type": "number" },
          "onePercentLowFps": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "notes": { "$ref": "#/$defs/localizedText" }
  },
  "additionalProperties": true,
  "$defs": {
    "resultGroupField": {
      "enum": ["gameMode", "resolution", "preset", "upscaling", "frameGeneration", "graphicsApi"]
    },
    "localizedText": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "properties": { "ja": { "type": "string" }, "en": { "type": "string" } }, "additionalProperties": { "type": "string" } }
      ]
    }
  }
}
